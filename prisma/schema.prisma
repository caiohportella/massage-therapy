model ReminderLog {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String
  sentAt    DateTime @default(now())
  type      String // exemplo: "2h antes", "24h antes"

  user   User   @relation(fields: [userId], references: [id])
  userId String
}
